# NowLink configuration — copy to .env and fill in values
# Never commit .env to git

NOWLINK_INSTANCE_URL=https://your-instance.service-now.com
NOWLINK_PAGE_SIZE=20

# Request timeout in seconds. Default 60 — conservative for PDI compatibility.
# Lower this (e.g. 30) for production instances which respond faster.
NOWLINK_REQUEST_TIMEOUT=60
